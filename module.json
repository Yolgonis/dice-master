{
  "id": "dice-master",
  "title": "Dice Master",
  "description": "GM-controlled per-user dice influence with isolated roll workflows, configurable strategies, and Better/Worse bias limits.",
  "version": "0.9.0",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "socket": true,
  "authors": [
    {
      "name": "Yolgonis"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13.351",
    "maximum": "14.999"
  },
  "esmodules": [
    "dice-master.js"
  ],
  "styles": [
    "dice-master.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pl",
      "name": "Polski",
      "path": "lang/pl.json"
    },
    {
      "lang": "tr",
      "name": "Türkçe",
      "path": "lang/tr.json"
    }
  ],
  "relationships": {
    "optional": [
      {
        "id": "socketlib",
        "type": "module"
      },
      {
        "id": "dice-so-nice",
        "type": "module"
      },
      {
        "id": "lib-wrapper",
        "type": "module"
      }
    ],
    "conflicts": [
      {
        "id": "fumble-switch",
        "type": "module",
        "reason": "Dice Master is standalone and must not be enabled together with the conflicting original module."
      }
    ]
  },
  "license": "LICENSE",
  "url": "https://github.com/Yolgonis/dice-master",
  "bugs": "https://github.com/Yolgonis/dice-master/issues",
  "manifest": "https://github.com/Yolgonis/dice-master/releases/latest/download/module.json",
  "download": "https://github.com/Yolgonis/dice-master/releases/download/v0.9.0/module.zip"
}
